# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# Supabase — get from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# WARNING: service role key bypasses RLS — only use in trusted server contexts, never expose to browser
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (public key only — secret key goes in backend/edge functions)
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id

# App config
VITE_APP_URL=http://localhost:5173
